# =============================================================================
# Institutional Equity Research Platform — environment configuration
# =============================================================================
# Copy to `.env` and edit. Every value below has a working default, so the
# stack starts with an empty file; what follows documents what each one does
# and which ones a production deployment must set.
#
# The settings marked  ⚠ REQUIRED IN PRODUCTION  are checked at startup by
# `Settings.production_readiness_problems()` and surfaced by /health/ready.
# The application will refuse to sign tokens or encrypt secrets in production
# without them, rather than falling back to a generated key that dies on
# restart.
# =============================================================================

# --- application -------------------------------------------------------------
APP_NAME="Institutional Equity Research Platform"
APP_VERSION=1.0.0
# development | staging | production
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- persistence -------------------------------------------------------------
# SQLite by default so the stack runs with zero infrastructure. Railway and
# any real deployment inject a Postgres DSN here.
#   postgresql+psycopg://user:password@host:5432/ierp
DATABASE_URL=sqlite+pysqlite:///./ierp.db
DB_ECHO=false

# --- cache -------------------------------------------------------------------
# Optional. With no Redis the rate limiter runs per-process, which is correct
# for a single instance and stated as a limitation for more than one.
REDIS_URL=
CACHE_TTL_SECONDS=300

# =============================================================================
# SECURITY  —  Module 10
# =============================================================================
# ⚠ REQUIRED IN PRODUCTION. Signs every JWT. Generate with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# A predictable signing key means anyone can mint an admin session.
SECRET_KEY=

# ⚠ REQUIRED IN PRODUCTION (falls back to SECRET_KEY). Derives the AES-256-GCM
# key for encrypted-at-rest tenant secrets. Rotating this without a migration
# makes existing stored secrets undecryptable.
ENCRYPTION_KEY=

JWT_ISSUER=ierp
# Short access tokens with rotating refresh tokens: a stolen access token
# expires in fifteen minutes and a stolen refresh token is detected on reuse.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Refresh-cookie lifetime when the user ticks "remember me" at sign-in. The
# access token's TTL is deliberately unchanged: a long-lived bearer token that
# cannot be revoked is a far worse trade than a silent refresh.
REMEMBER_ME_TTL_SECONDS=7776000

# Turn on the first-party identity system. With this false the platform runs a
# clearly-labelled development identity and every caller is a super admin —
# fine locally, never acceptable in production.
NATIVE_AUTH=false

# Cookie transport for the refresh token. Secure is forced on in production
# regardless of COOKIE_SECURE.
COOKIE_DOMAIN=
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax
CSRF_ENABLED=true

# Account lockout after repeated failures, in addition to the per-IP rate
# limit. A distributed attempt defeats an IP limit; a shared office NAT
# defeats an account limit. Both are needed.
MAX_FAILED_LOGINS=8
LOGIN_LOCKOUT_SECONDS=900

# --- OAuth providers ---------------------------------------------------------
# Absent credentials disable the provider cleanly: /auth/config stops
# advertising it and the button disappears. Neither is required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where the provider sends the user back. Must match the provider console.
OAUTH_REDIRECT_BASE=http://localhost:3000

# --- legacy Clerk shim (Module 1) --------------------------------------------
# Superseded by NATIVE_AUTH. Retained so an existing deployment keeps working.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=
AUTH_DEV_MODE=true

# =============================================================================
# EMAIL
# =============================================================================
# With no SMTP_HOST the platform uses a console transport that records the
# message and logs the link, so verification, password reset and magic link
# all work end to end in development with no mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ierp.local
SMTP_FROM_NAME="Equity Research Platform"
# Base URL used to build links inside emails — the frontend, not the API.
EMAIL_LINK_BASE=http://localhost:3000

# =============================================================================
# MULTI-TENANCY
# =============================================================================
# The organisation that owns rows written before Module 10 existed, and the
# one the development identity is bound to.
DEFAULT_TENANT_SLUG=demo-capital
# Registering an email creates its own organisation. Set false for a
# single-tenant deployment where an admin invites everyone.
ALLOW_SELF_SIGNUP=true
SIGNUP_DEFAULT_PLAN=free

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
# memory | redis. Use redis when running more than one replica, or each
# process enforces its own share of the limit.
RATE_LIMIT_BACKEND=memory

# =============================================================================
# OBSERVABILITY
# =============================================================================
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json in production so logs are parseable; console locally so they are
# readable.
LOG_FORMAT=console
METRICS_ENABLED=true
METRICS_RETENTION_DAYS=30
# Critical security events are retained past this regardless.
AUDIT_RETENTION_DAYS=365

# =============================================================================
# BACKGROUND JOBS
# =============================================================================
# An in-process worker thread. Adequate for one instance; set false and run
# `python -m app.worker` as a separate process when scaling out, so a heavy
# report render cannot starve the API event loop.
WORKER_ENABLED=false
WORKER_POLL_SECONDS=2.0
WORKER_CONCURRENCY=2
# A job whose lease expires is reclaimed, so a worker that dies mid-job does
# not strand the work.
WORKER_LEASE_SECONDS=300
# Exactly one process in the deployment should run the scheduler.
SCHEDULER_ENABLED=false

# =============================================================================
# BACKUP
# =============================================================================
BACKUP_DIR=./backups
# Retention by count rather than age: an instance that was down for a
# fortnight should not wake up and delete its only copies.
BACKUP_RETENTION_COUNT=14

# =============================================================================
# AI PROVIDERS  (Module 6)
# =============================================================================
# Fallback order is Gemini -> OpenRouter -> OpenAI -> Claude -> Offline,
# declared in `providers/router.FALLBACK_ORDER`. The chain skips any provider
# with no key, so configuring one is enough and configuring none is safe.
#
# NEVER commit a real key. This file is the template; `.env` is gitignored.

# Google AI Studio: https://aistudio.google.com/apikey  (primary)
# The free tier has a daily generation quota. When it is spent the API returns
# 429 with a QuotaFailure detail and the router falls straight through to the
# next provider instead of retrying. Use GET /api/v1/ai/health to tell a spent
# quota apart from a bad key — both look like "AI not working" otherwise.
GEMINI_API_KEY=

# https://openrouter.ai/keys  (PRIMARY writing layer as of Phase 1)
#
# OpenRouter leads the fallback chain because it answers reliably, whereas the
# Gemini free tier exhausts its daily generation quota within a few reports and
# then 429s for the rest of the day — which silently degraded the platform to
# deterministic template prose. Gemini is retained immediately behind it.
OPENROUTER_API_KEY=

# Model OpenRouter serves the writing layer with. Kept in configuration rather
# than code: catalogue availability varies by account entitlement, and several
# well-known model ids answer 404 "No endpoints found" on keys that cannot
# reach that upstream provider. Verified working on the current key:
#   openai/gpt-4o-mini              (default; fast, cheap, good prose)
#   deepseek/deepseek-chat
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# Attribution sent as HTTP-Referer / X-Title. OpenRouter rate-limits
# unattributed traffic harder and omits it from the account activity page,
# which makes spend impossible to audit.
OPENROUTER_SITE_URL=https://frontend-production-1a313.up.railway.app
OPENROUTER_APP_NAME=EquityPilotAI

# Optional additional providers, tried after the two above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Force one provider to the front of the chain. Blank uses the declared order.
AI_PREFERRED_PROVIDER=

AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000

# Keep the deterministic offline provider as a last resort, so the AI layer
# degrades to grounded, fully-cited template output rather than erroring when
# every live provider is unavailable. Set false to make that a hard failure.
AI_MOCK_MODE=true

# =============================================================================
# CORS
# =============================================================================
# JSON list. Must be the exact frontend origin in production; a plaintext
# http origin is flagged by the readiness check.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# =============================================================================
# DOMAIN DEFAULTS  (from the workbook specification)
# =============================================================================
BASE_CURRENCY=INR
DISPLAY_UNIT=cr
HISTORICAL_YEARS=10
FORECAST_YEARS=10

# =============================================================================
# DOCUMENT STORAGE — Module 7 (asynchronous ingestion)
# =============================================================================
# The original upload is retained permanently. Without it a re-index cannot
# re-parse, and a failed ingestion loses the document outright.
#
# "local" writes to DOCUMENT_STORAGE_PATH — attach a Railway Volume there.
# "s3" / "r2" / "minio" use the S3-compatible client (needs boto3).
DOCUMENT_STORAGE_BACKEND=local

# ⚠ MUST be a mounted volume in production. On Railway: add a Volume to the
# API service with this mount path. A container filesystem is ephemeral, so
# without a volume every uploaded PDF is lost on the next deploy.
DOCUMENT_STORAGE_PATH=/data/documents

# S3-compatible settings. Ignored unless the backend above is S3-compatible.
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_REGION=
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=

# Largest single upload accepted. 500-1000 page annual reports with scanned
# plates run to a few hundred megabytes.
DOCUMENT_MAX_UPLOAD_MB=256

# Refuse an upload that would leave the volume below this much free space,
# rather than letting a worker die part-way through a large write.
DOCUMENT_MIN_FREE_DISK_MB=512

# Keep the stored bytes when a document row is deleted. Off by default: a
# deliberate delete should not leave orphaned files on the volume.
DOCUMENT_KEEP_BYTES_ON_DELETE=false

# =============================================================================
# MARKET DATA
# =============================================================================
# The platform is India-only (NSE/BSE). For Indian listings the primary tier
# is the exchange's own NSE live endpoint (needs no API key); the rest of the
# chain is preserved behind it as fallback.
# Provider chain, in priority order:
#   0. NSE India (Live)            the exchange's own quote endpoint (no key)
#   1. Finnhub                     profile, quote, key metrics, news, earnings
#   2. Financial Modeling Prep     the above plus statements, ratios, history
#   3. Yahoo Finance               quote and price history only
#   4. Internal financial database the platform's own stored figures
#   5. Uploaded documents (RAG)    figures extracted from ingested filings
#
# Each tier is tried in turn when the one before it fails, times out, is rate
# limited, or does not serve the endpoint asked for. The tier that answered is
# named on every response. A provider that returns no usable price is never
# reported as a price=None "success"; if no tier prices the symbol the request
# fails loudly (502) rather than faking an empty result.
#
# Set NSE_MARKET_ENABLED=false to disable the NSE live tier (e.g. in a
# network-restricted deployment) and fall straight through to the chain below.
NSE_MARKET_ENABLED=true
FINNHUB_API_KEY=
FMP_API_KEY=
MARKET_CACHE_TTL_SECONDS=300
MARKET_TIMEOUT_SECONDS=15.0
MARKET_RETRY_ATTEMPTS=3

# --- Retrieval Engine 2.0 ---------------------------------------------------
# Semantic embedding provider. Blank selects the first configured one in the
# brief's preference order: bge-m3 (via OPENROUTER_API_KEY), jina-v3, then
# openai-small. bge-m3 is the only genuinely multilingual option of the three
# and is the default for that reason.
EMBEDDING_PROVIDER=
# jina-embeddings-v3, the second-preference provider.
JINA_API_KEY=
# Cross-encoder reranker (bge-reranker-large / jina-reranker-v2). All three
# must be set; otherwise the dependency-free lexical-coverage reranker runs.
# No reranker is reachable from this deployment, so it is unset by default.
RERANKER_ENDPOINT=
RERANKER_MODEL=
RERANKER_API_KEY=
# Master switch for the pgvector hybrid engine. It degrades to the legacy
# in-memory index automatically when no chunk carries a semantic vector, so
# leaving this on is safe before the backfill has run.
HYBRID_RETRIEVAL_ENABLED=true

# --- Retrieval 2.1: cross-encoder reranking --------------------------------
# Provider is chosen by name alone; nothing else changes between them.
#   jina   -> jina-reranker-v2-base-multilingual  (needs RERANK_API_KEY)
#   cohere -> rerank-multilingual-v3.0            (needs RERANK_API_KEY)
#   openai -> gpt-4o-mini as a judge; NOT a cross-encoder, slower and dearer
#   local  -> sentence-transformers cross-encoder; ~1.3GB resident, so it
#             does not fit this deployment's 1GB container
#   none / unset -> dependency-free lexical-coverage reranker
RERANK_PROVIDER=
RERANK_API_KEY=
RERANK_MODEL=
# Only to override a provider's default endpoint (self-hosted or a proxy).
RERANK_ENDPOINT=

# --- Multilingual AI Response Engine -----------------------------------------
# Which translator renders the final answer: llm | glossary | passthrough | none
# `llm` reuses the configured AI provider; no additional credential is needed.
TRANSLATION_PROVIDER=llm
# Master switch for multilingual responses. Detection still runs when false.
MULTILINGUAL_ENABLED=true
# Fallback language when detection is inconclusive and no preference is saved.
# Also the canonical storage language for the single knowledge base.
DEFAULT_RESPONSE_LANGUAGE=english
