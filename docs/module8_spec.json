  "diversification_checks": [
    {
      "row": 34,
      "label": "Largest position within policy limit",
      "formula": "=IF(IFERROR(MAX(PF_Weight),0)<=MaxPositionSize,\"\u2713 within limit\",\"\u26a0 oversized position\")"
    },
    {
      "row": 35,
      "label": "Top-5 concentration below 50%",
      "formula": "=IF(IFERROR(SUMPRODUCT(LARGE(PF_Weight,{1;2;3;4;5})),0)<=0.5,\"\u2713 diversified\",\"\u26a0 concentrated\")"
    },
    {
      "row": 36,
      "label": "At least 8 effective positions",
      "formula": "=IF(IFERROR(1/SUMPRODUCT(PF_Weight,PF_Weight),0)>=8,\"\u2713 adequate breadth\",\"\u26a0 too few effective positions\")"
    },
    {
      "row": 37,
      "label": "No sector above 35%",
      "formula": "=IF(IFERROR(MAX(E9:E22),0)<=0.35,\"\u2713 sector limits respected\",\"\u26a0 sector overweight\")"
    },
    {
      "row": 38,
      "label": "Target weights sum to 100%",
      "formula": "=IF(ABS(SUM(F9:F22)-1)<0.01,\"\u2713 targets set\",\"\u25c6 set sector targets to enable rebalancing\")"
    }
  ],
  "portfolio_metrics": [
    {
      "label": "Portfolio market value (\u20b9)",
      "formula": "=PF_Value"
    },
    {
      "label": "Top-5 concentration",
      "formula": "=IFERROR(SUMPRODUCT(LARGE(PF_Weight,{1;2;3;4;5})),0)"
    },
    {
      "label": "Total cost (\u20b9)",
      "formula": "=PF_Cost"
    },
    {
      "label": "Sectors represented",
      "formula": "=COUNTIF(D9:D22,\">0\")"
    },
    {
      "label": "Unrealised gain / (loss) (\u20b9)",
      "formula": "=PF_PnL"
    },
    {
      "label": "Largest sector weight",
      "formula": "=IFERROR(MAX(E9:E22),0)"
    },
    {
      "label": "Total return",
      "formula": "=IFERROR(PF_PnL/PF_Cost,0)"
    },
    {
      "label": "Effective positions (1/HHI)",
      "formula": "=IFERROR(1/SUMPRODUCT(PF_Weight,PF_Weight),0)"
    },
    {
      "label": "Number of positions",
      "formula": "=COUNTIF(PF_Names,\"?*\")"
    },
    {
      "label": "Expected CAGR (3y, held names)",
      "formula": "=IFERROR((TargetPrice/CMP)^(1/3)-1,0)"
    },
    {
      "label": "Largest position weight",
      "formula": "=IFERROR(MAX(PF_Weight),0)"
    },
    {
      "label": "Cash weight",
      "formula": "=IFERROR('36 Portfolio'!M8/(PF_Value+'36 Portfolio'!M8),0)"
    },
    {
      "label": "Portfolio risk score (AI-weighted)",
      "formula": "=IFERROR(SUMPRODUCT(PF_Weight,IF(ISNUMBER('36 Portfolio'!$S$12:$S$36),'36 Portfolio'!$S$12:$S$36,0)),RiskScore)",
      "ai_linked": true
    },
    {
      "label": "Sector concentration (HHI)",
      "formula": "=IFERROR(SUMPRODUCT($E$12:$E$25,$E$12:$E$25),0)",
      "ai_linked": true
    },
    {
      "label": "Portfolio expected CAGR (weighted)",
      "formula": "=IFERROR(SUMPRODUCT(PF_Weight,IF(ISNUMBER('36 Portfolio'!$T$12:$T$36),'36 Portfolio'!$T$12:$T$36,0)),0)",
      "ai_linked": true
    },
    {
      "label": "Largest sector weight",
      "formula": "=IFERROR(MAX($E$12:$E$25),0)",
      "ai_linked": true
    },
    {
      "label": "Portfolio quality score (weighted)",
      "formula": "=IFERROR(SUMPRODUCT(PF_Weight,IF(ISNUMBER('36 Portfolio'!$Q$12:$Q$36),'36 Portfolio'!$Q$12:$Q$36,0)),OverallScoreCalc)",
      "ai_linked": true
    },
    {
      "label": "Names needed for full diversification",
      "formula": "=MAX(0,15-COUNTIF(PF_Names,\"?*\"))",
      "ai_linked": true
    },
    {
      "label": "Diversification score (0-100)",
      "formula": "=IFERROR(MIN(100,ROUND(100*(1-SUMPRODUCT(PF_Weight,PF_Weight))*(MIN(1,COUNTIF(PF_Names,\"?*\")/15)),0)),0)",
      "ai_linked": true
    },
    {
      "label": "Rebalancing trades required",
      "formula": "=COUNTIF($H$12:$H$25,\"INCREASE\")+COUNTIF($H$12:$H$25,\"REDUCE\")",
      "ai_linked": true
    }
  ],
  "holding_columns": [
