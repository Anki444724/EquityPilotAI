{
  "alert_rules": [
    {
      "row": 9,
      "name": "Price below buy zone",
      "condition": "CMP <= intrinsic \u00d7 (1 \u2212 MoS)",
      "threshold": "=DCF_IntrinsicValue*(1-MarginOfSafety)",
      "source": "=CMP",
      "action": "Accumulate",
      "priority": "High",
      "operator": "lte"
    },
    {
      "row": 10,
      "name": "Price above target",
      "condition": "CMP >= blended target",
      "threshold": "=TargetPrice",
      "source": "=CMP",
      "action": "Review / trim",
      "priority": "High",
      "operator": "gte"
    },
    {
      "row": 11,
      "name": "Upside collapsed",
      "condition": "Upside < 5%",
      "threshold": 0.05,
      "source": "=Upside",
      "action": "Re-underwrite",
      "priority": "Medium",
      "operator": "lt"
    },
    {
      "row": 12,
      "name": "Score downgraded",
      "condition": "Score < 55",
      "threshold": 55,
      "source": "=OverallScoreCalc",
      "action": "Reduce position",
      "priority": "High",
      "operator": "lt"
    },
    {
      "row": 13,
      "name": "Rating below A",
      "condition": "Rating is BBB or lower",
      "threshold": "BBB",
      "source": "=InstRating",
      "action": "Review thesis",
      "priority": "Medium",
      "operator": "custom"
    },
    {
      "row": 14,
      "name": "Risk score deteriorated",
      "condition": "Risk score < 75%",
      "threshold": 0.75,
      "source": "=RiskScore",
      "action": "Investigate flags",
      "priority": "High",
      "operator": "lt"
    },
    {
      "row": 15,
      "name": "Red flags failed",
      "condition": "Severity points > 10",
      "threshold": 10,
      "source": "=RedFlagsFailed",
      "action": "Read sheet 29",
      "priority": "High",
      "operator": "gt"
    },
    {
      "row": 16,
      "name": "Leverage stretched",
      "condition": "Net debt / EBITDA > 3.0x",
      "threshold": 3,
      "source": "=IFERROR(NetDebt/'06 Historical IS'!L22,0)",
      "action": "Credit review",
      "priority": "High",
      "operator": "gt"
    },
    {
      "row": 17,
      "name": "Interest cover thin",
      "condition": "EBIT / interest < 3.0x",
      "threshold": 3,
      "source": "=IFERROR('06 Historical IS'!L25/'06 Historical IS'!L27,0)",
      "action": "Credit review",
      "priority": "High",
      "operator": "lt"
    },
    {
      "row": 18,
      "name": "Promoter pledge",
      "condition": "Pledge > 0%",
      "threshold": 0,
      "source": "='14 Shareholding'!N23",
      "action": "Governance review",
      "priority": "High",
      "operator": "gt"
    },
    {
      "row": 19,
      "name": "Cash conversion weak",
      "condition": "CFO / PAT < 0.8x",
      "threshold": 0.8,
      "source": "='08 Historical CF'!L45",
      "action": "Forensic review",
      "priority": "Medium",
      "operator": "lt"
    },
    {
      "row": 20,
      "name": "Terminal value heavy",
      "condition": "TV > 75% of EV",
      "threshold": 0.75,
      "source": "=DCF_TVpct",
      "action": "Stress the DCF",
      "priority": "Medium",
      "operator": "gt"
    },
    {
      "row": 21,
      "name": "Model integrity",
      "condition": "All internal checks pass",
      "threshold": "OK",
      "source": "=ModelIntegrity",
      "action": "Fix before use",
      "priority": "Critical",
      "operator": "custom"
    },
    {
      "row": 22,
      "name": "Position oversized",
      "condition": "Weight > max position size",
      "threshold": "=MaxPositionSize",
      "source": "=IFERROR(MAX(PF_Weight),0)",
      "action": "Rebalance",
      "priority": "Medium",
      "operator": "gt"
    }
  ],
